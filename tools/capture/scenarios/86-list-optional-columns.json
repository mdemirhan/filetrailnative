{
  "name": "86-list-optional-columns",
  "description": "List view with Date Created and Permissions shown, in a chosen order",
  "features": [
    "F-767",
    "F-768"
  ],
  "tier": [
    "wp",
    "wave",
    "final"
  ],
  "root": "lighthouse/Lighthouse",
  "now": "2026-10-13T14:38:00",
  "steps": [
    {
      "step": "window",
      "width": 1200,
      "height": 760
    },
    {
      "step": "prefs",
      "prefs": {
        "theme": "light",
        "accent": "#007aff",
        "zoomPercent": 100,
        "density": "comfortable",
        "viewMode": "details",
        "sortBy": "name",
        "sortDirection": "asc",
        "favoritesPlacement": "separate",
        "detailColumns": {
          "modified": true,
          "size": true,
          "kind": true,
          "created": true,
          "permissions": true
        }
      }
    },
    {
      "step": "open",
      "path": "app/src/components"
    },
    {
      "step": "wait",
      "ms": 300
    },
    {
      "step": "snapshot",
      "name": "main"
    },
    {
      "step": "geometry",
      "name": "main"
    }
  ]
}
