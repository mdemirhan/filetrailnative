{
  "name": "a17-outside-changes",
  "description": "A17: a drag of files onto a folder moves them; an outside change appears; hidden files show on ⇧⌘.; a new file's date is relative. (Ejecting and opening disk images need a mounted image: the P2 disk tests prove them.)",
  "features": ["F-585","F-683","F-685","F-695","F-774","F-831"],
  "behaviors": ["B-CLIP-173","B-CLIP-176","B-INFO-079","B-NAV-130","B-NAV-134","B-VIEW-190"],
  "tier": ["wave", "final"],
  "setup": {"scratch":true},
  "root": "lighthouse/Lighthouse",
  "now": "2026-10-13T14:38:00",
  "steps": [
    {"step":"window","width":1200,"height":760},
    {"step":"prefs","prefs":{"theme":"light","accent":"#007aff","zoomPercent":100,"density":"comfortable","viewMode":"details","sortBy":"name","sortDirection":"asc","favoritesPlacement":"separate"}},
    {"step":"fs","op":"create","path":"app/src/components/Inbox","directory":true},
    {"step":"fs","op":"create","path":"app/src/components/.notes","contents":"hidden\n"},
    {"step":"open","path":"app/src/components"},
    {"step":"wait","ms":800},
    {"step":"drag","from":{"name":"list row","text":"Toast.jsx"},"to":{"name":"list row","text":"Inbox"}},
    {"step":"wait","ms":1500},
    {"step":"expect","element":{"name":"list row","text":"Toast.jsx"},"visible":false},
    {"step":"fs","op":"create","path":"app/src/components/Made Outside.jsx","contents":"export {};\n"},
    {"step":"wait","ms":1500},
    {"step":"expect","element":{"name":"list row","text":"Made Outside.jsx"},"visible":true},
    {"step":"expect","element":{"name":"list row date","index":3},"text":"Just now"},
    {"step":"expect","element":{"name":"list row","text":".notes"},"visible":false},
    {"step":"key","key":".","modifiers":["cmd","shift"]},
    {"step":"wait","ms":800},
    {"step":"expect","element":{"name":"list row","text":".notes"},"visible":true},
    {"step":"snapshot","name":"main"},
    {"step":"geometry","name":"main"},
    {"step":"click","element":"list row","text":"Inbox","count":2},
    {"step":"wait","ms":500},
    {"step":"expect","element":{"name":"list row","text":"Toast.jsx"},"visible":true}
  ]
}
