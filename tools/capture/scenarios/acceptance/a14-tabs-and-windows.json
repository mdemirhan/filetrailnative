    {"step":"selectTab","index":0},
    {"step":"expect","element":"title","text":"components"},
    {"step":"expect","element":{"name":"list row","text":"Avatar.jsx"},"visible":true},
    {"step":"selectTab","index":1},
    {"step":"expect","element":"title","text":"src"},
    {"step":"expect","element":{"name":"icon","text":"components"},"visible":true},
    {"step":"snapshot","name":"main"},
    {"step":"geometry","name":"main"},
    {"step":"command","id":"moveTabToNewWindow"},
    {"step":"selectWindow","index":1},
    {"step":"expect","element":"title","text":"src"},
    {"step":"selectWindow","index":0},
    {"step":"expect","element":"tab","count":0},
    {"step":"expect","element":"title","text":"components"},
    {"step":"command","id":"mergeAllWindows"},
