{
  "name": "a04-paste-never-destroys",
  "description": "A4: a paste onto conflicts opens the review sheet; each For-all choice says what it will do; Keep All keeps both; a single file conflict asks as Finder does and Keep Both keeps both. (Replace's Trash and crash recovery are proven by the P3 golden tests: this flow does not fill the real Trash.)",
  "features": ["F-681","F-842","F-845","F-864","F-865","F-866","F-867","F-868"],
  "behaviors": ["B-CLIP-075","B-CLIP-076","B-CLIP-083","B-CLIP-084","B-CLIP-085","B-CLIP-088","B-CLIP-089","B-CLIP-090","B-CLIP-101","B-CLIP-102","B-CLIP-106"],
  "tier": ["wave","final"],
  "setup": {"scratch":true},
  "root": "lighthouse/Lighthouse",
  "now": "2026-10-13T14:38:00",
  "steps": [
    {"step":"window","width":1200,"height":760},
    {"step":"prefs","prefs":{"theme":"light","accent":"#007aff","zoomPercent":100,"density":"comfortable","viewMode":"details","sortBy":"name","sortDirection":"asc","favoritesPlacement":"separate"}},
    {"step":"fs","op":"create","path":"app/src/components/Shared","directory":true},
    {"step":"fs","op":"create","path":"app/src/components/Shared/notes.txt","contents":"new notes\n"},
    {"step":"fs","op":"create","path":"app/src/components/Copies","directory":true},
    {"step":"fs","op":"create","path":"app/src/components/Copies/Avatar.jsx","contents":"older avatar\n"},
    {"step":"fs","op":"create","path":"app/src/components/Copies/Toast.jsx","contents":"older toast\n"},
    {"step":"fs","op":"create","path":"app/src/components/Copies/TripMap.jsx","contents":"older map\n"},
    {"step":"fs","op":"create","path":"app/src/components/Copies/Shared","directory":true},
    {"step":"fs","op":"create","path":"app/src/components/Copies/Shared/old.txt","contents":"old\n"},
    {"step":"open","path":"app/src/components"},
    {"step":"wait","ms":800},
    {"step":"select","names":["Avatar.jsx","Shared","Toast.jsx"]},
    {"step":"key","key":"c","modifiers":["cmd"]},
    {"step":"click","element":"list row","text":"Copies","count":2},
    {"step":"expect","element":"title","text":"Copies"},
    {"step":"key","key":"v","modifiers":["cmd"]},
    {"step":"expectSheet","name":"review sheet"},
    {"step":"expect","element":"review sheet title","text":"3 of 3 items already exist in “Copies”"},
    {"step":"expect","element":"review choice","count":4},
    {"step":"expect","element":"review hint","text":"Existing items stay as they are."},
    {"step":"snapshot","name":"main"},
    {"step":"geometry","name":"main"},
    {"step":"click","element":"review choice","text":"Add Missing"},
    {"step":"expect","element":"review hint","text":"Folders merge. Only files that aren’t there yet are added."},
    {"step":"click","element":"review choice","text":"Replace"},
    {"step":"expect","element":"review note","visible":true},
    {"step":"snapshot","name":"replace"},
    {"step":"click","element":"review choice","text":"Keep All"},
    {"step":"sheetButton","label":"Paste"},
    {"step":"wait","ms":1500},
    {"step":"expect","element":{"name":"list row","text":"Avatar copy.jsx"},"visible":true},
    {"step":"expect","element":{"name":"list row","text":"Toast copy.jsx"},"visible":true},
    {"step":"key","key":"[","modifiers":["cmd"]},
    {"step":"select","names":["TripMap.jsx"]},
    {"step":"key","key":"c","modifiers":["cmd"]},
    {"step":"click","element":"list row","text":"Copies","count":2},
    {"step":"key","key":"v","modifiers":["cmd"]},
    {"step":"expectSheet","name":"alert"},
    {"step":"expect","element":"alert title","text":"“TripMap.jsx” already exists in “Copies”"},
    {"step":"snapshot","name":"alert"},
    {"step":"sheetButton","label":"Keep Both"},
    {"step":"wait","ms":1500},
    {"step":"expect","element":{"name":"list row","text":"TripMap copy.jsx"},"visible":true}
  ]
}
