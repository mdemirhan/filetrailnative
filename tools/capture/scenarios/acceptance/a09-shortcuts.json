{
  "name": "a09-shortcuts",
  "description": "A9: Settings › Shortcuts: a plain letter is refused, a key another command has asks to reassign, a free key is kept and then works in the window",
  "features": ["F-902","F-903","F-904","F-905","F-906"],
  "behaviors": ["B-DLG-210","B-DLG-212","B-DLG-213","B-DLG-219","B-DLG-221","B-DLG-222","B-DLG-229","B-DLG-231"],
  "tier": ["wave","final"],
  "setup": {"scratch":true},
  "root": "lighthouse/Lighthouse",
  "now": "2026-10-13T14:38:00",
  "steps": [
    {"step":"window","width":1200,"height":760},
    {"step":"prefs","prefs":{"theme":"light","accent":"#007aff","zoomPercent":100,"density":"comfortable","viewMode":"details","sortBy":"name","sortDirection":"asc","favoritesPlacement":"separate"}},
    {"step":"open","path":"app/src/components"},
    {"step":"menu","path":["File Trail","Settings…"]},
    {"step":"selectWindow","title":"Settings"},
    {"step":"click","element":"settings section","text":"Shortcuts"},
    {"step":"expect","element":"settings title","text":"Shortcuts"},
    {"step":"click","element":"shortcut search field"},
    {"step":"type","text":"New Folder"},
    {"step":"wait","ms":300},
    {"step":"expect","element":"shortcut row label","count":1},
    {"step":"expect","element":{"name":"shortcut key","index":0},"text":"⇧⌘N"},
    {"step":"expect","element":{"name":"shortcut key","index":1},"text":"+"},
    {"step":"click","element":"shortcut key","index":1},
    {"step":"expect","element":{"name":"shortcut key","index":1},"text":"Press keys…"},
    {"step":"key","key":"n"},
    {"step":"expect","element":"shortcut note","text":"N on its own types into the file list. Add ⌘ or ⌃."},
    {"step":"key","key":"d","modifiers":["cmd"]},
    {"step":"expect","element":"shortcut note","text":"⌘D is used by Duplicate."},
    {"step":"snapshot","name":"main"},
    {"step":"geometry","name":"main"},
    {"step":"sheetButton","label":"Cancel"},
    {"step":"expect","element":"shortcut note","visible":false},
    {"step":"click","element":"shortcut key","index":1},
    {"step":"key","key":"j","modifiers":["cmd","option"]},
    {"step":"wait","ms":300},
    {"step":"expect","element":{"name":"shortcut key","index":1},"text":"⌥⌘J"},
    {"step":"selectWindow","index":0},
    {"step":"click","element":"list row","text":"Avatar.jsx"},
    {"step":"key","key":"j","modifiers":["cmd","option"]},
    {"step":"expectSheet","name":"rename field"},
    {"step":"expect","element":"rename field","text":"untitled folder"}
  ]
}
