    {"step":"expect","element":{"name":"list row","text":"TripList.jsx"},"visible":true},
    {"step":"click","element":"search options button"},
    {"step":"click","element":"search option","text":"Regex"},
    {"step":"wait","ms":1500},
    {"step":"expect","element":{"name":"list row","text":"TripList.jsx"},"visible":true},
    {"step":"click","element":"search scope","text":"Home"},
    {"step":"wait","ms":300},
    {"step":"expect","element":"selected search scope","text":"Home"},
    {"step":"click","element":"search scope","text":"“Lighthouse”"},
    {"step":"wait","ms":1500},
    {"step":"expect","element":"selected search scope","text":"“Lighthouse”"},
    {"step":"click","element":"search filter field"},
    {"step":"type","text":"components"},
    {"step":"wait","ms":300},
    {"step":"expect","element":{"name":"list row","text":"TripList.jsx"},"visible":true},
    {"step":"expect","element":{"name":"list row","text":"trip.json"},"visible":false},
