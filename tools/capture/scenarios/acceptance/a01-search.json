    {"step":"expect","element":{"name":"list row","text":"TripCard.jsx"},"visible":true},
    {"step":"snapshot","name":"main"},
    {"step":"geometry","name":"main"},
    {"step":"type","text":"c"},
    {"step":"wait","ms":300},
    {"step":"expect","element":{"name":"list row","text":"TripCard.jsx"},"visible":true},
    {"step":"expect","element":{"name":"list row","text":"TripList.jsx"},"visible":false},
    {"step":"key","key":"Backspace"},
    {"step":"wait","ms":300},
    {"step":"expect","element":{"name":"list row","text":"TripList.jsx"},"visible":true},
    {"step":"click","element":"search options button"},
    {"step":"expectSheet","name":"search options menu"},
    {"step":"expect","element":{"name":"checked search option","index":0},"text":"Name"},
    {"step":"expect","element":{"name":"checked search option","index":1},"text":"Plain Text"},
