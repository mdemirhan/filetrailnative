{
  "name": "a10-customize-toolbar",
  "description": "A10: Customize Toolbar in place: drag an item in, move it along, drag it out, click one to add it at the end, Esc to finish",
  "features": ["F-718","F-719","F-720"],
  "behaviors": ["B-VIEW-132","B-VIEW-133","B-VIEW-134","B-VIEW-135","B-VIEW-136","B-VIEW-137"],
  "tier": ["wave", "final"],
  "root": "lighthouse/Lighthouse",
  "now": "2026-10-13T14:38:00",
  "steps": [
    {"step":"window","width":1200,"height":760},
    {"step":"prefs","prefs":{"theme":"light","accent":"#007aff","zoomPercent":100,"density":"comfortable","viewMode":"details","sortBy":"name","sortDirection":"asc","favoritesPlacement":"separate"}},
    {"step":"open","path":"app/src/components"},
    {"step":"menu","path":["View","Customize Toolbar…"]},
    {"step":"expectSheet","name":"toolbar customize panel"},
    {"step":"expect","element":"toolbar customize title","text":"Drag items into the toolbar"},
    {"step":"expect","element":{"name":"toolbar palette item","text":"New Tab"},"visible":true},
    {"step":"snapshot","name":"main"},
    {"step":"geometry","name":"main"},
    {"step":"drag","from":{"name":"toolbar palette item","text":"New Tab"},"to":{"name":"toolbar handle","text":"Forward"}},
    {"step":"wait","ms":500},
    {"step":"expect","element":{"name":"toolbar palette item","text":"New Tab"},"visible":false},
    {"step":"expect","element":{"name":"toolbar handle","text":"New Tab"},"visible":true},
    {"step":"drag","from":{"name":"toolbar handle","text":"New Tab"},"to":{"name":"toolbar handle","text":"Sort"}},
    {"step":"wait","ms":500},
    {"step":"expect","element":{"name":"toolbar handle","text":"New Tab"},"visible":true},
    {"step":"snapshot","name":"moved"},
    {"step":"drag","from":{"name":"toolbar handle","text":"New Tab"},"to":"content"},
    {"step":"wait","ms":500},
    {"step":"expect","element":{"name":"toolbar handle","text":"New Tab"},"visible":false},
    {"step":"expect","element":{"name":"toolbar palette item","text":"New Tab"},"visible":true},
    {"step":"click","element":"toolbar palette item","text":"Refresh"},
    {"step":"wait","ms":500},
    {"step":"expect","element":{"name":"toolbar palette item","text":"Refresh"},"visible":false},
    {"step":"expect","element":{"name":"toolbar handle","text":"Refresh"},"visible":true},
    {"step":"key","key":"Escape"},
    {"step":"expect","element":"toolbar customize panel","visible":false}
  ]
}
