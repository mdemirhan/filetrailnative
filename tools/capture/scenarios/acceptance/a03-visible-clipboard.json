{
  "name": "a03-visible-clipboard",
  "description": "A3: cut four files, see them dimmed and counted, open the clipboard list, remove one, and paste the rest in another window",
  "features": ["F-581","F-643","F-791","F-800","F-801","F-802"],
  "behaviors": ["B-CLIP-005","B-CLIP-011","B-CLIP-013","B-CLIP-015","B-CLIP-019","B-CLIP-020","B-CLIP-021","B-CLIP-031","B-CLIP-033","B-CLIP-054","B-CLIP-062","B-CLIP-078"],
  "tier": ["checkpoint", "wave", "final"],
  "setup": {"scratch":true},
  "root": "lighthouse/Lighthouse",
  "now": "2026-10-13T14:38:00",
  "steps": [
    {"step":"window","width":1200,"height":760},
    {"step":"prefs","prefs":{"theme":"light","accent":"#007aff","zoomPercent":100,"density":"comfortable","viewMode":"details","sortBy":"name","sortDirection":"asc","favoritesPlacement":"separate"}},
    {"step":"open","path":"app/src/components"},
    {"step":"select","names":["DatePicker.jsx","SearchField.jsx","Toast.jsx","TripList.jsx"]},
    {"step":"key","key":"x","modifiers":["cmd"]},
    {"step":"expect","element":"cut list row","count":4},
    {"step":"expect","element":"clipboard count","text":"4"},
    {"step":"click","element":"clipboard button"},
    {"step":"expectSheet","name":"clipboard popover"},
    {"step":"expect","element":"clipboard popover title","text":"4 items cut"},
    {"step":"expect","element":"clipboard popover item","count":4},
    {"step":"snapshot","name":"main"},
    {"step":"geometry","name":"main"},
    {"step":"key","key":"ArrowDown"},
    {"step":"key","key":"Backspace"},
    {"step":"wait","ms":300},
    {"step":"expect","element":"clipboard popover item","count":3},
    {"step":"expect","element":{"name":"clipboard popover item","text":"DatePicker.jsx"},"visible":false},
    {"step":"key","key":"Escape"},
    {"step":"expect","element":"clipboard popover","visible":false},
    {"step":"expect","element":"clipboard count","text":"3"},
    {"step":"expect","element":"cut list row","count":3},
    {"step":"newWindow"},
    {"step":"open","path":"app/src"},
    {"step":"expect","element":"clipboard count","text":"3"},
    {"step":"key","key":"v","modifiers":["cmd"]},
    {"step":"wait","ms":1500},
    {"step":"expect","element":{"name":"list row","text":"Toast.jsx"},"visible":true},
    {"step":"expect","element":{"name":"list row","text":"DatePicker.jsx"},"visible":false},
    {"step":"expect","element":"clipboard button","visible":false},
    {"step":"snapshot","name":"pasted"}
  ]
}
