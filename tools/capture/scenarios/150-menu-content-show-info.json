{
  "name": "150-menu-content-show-info",
  "description": "Show Info chosen from a file's context menu opens the Info panel",
  "features": [
    "F-808",
    "F-810",
    "F-815"
  ],
  "tier": [
    "wave",
    "final"
  ],
  "root": "lighthouse/Lighthouse",
  "now": "2026-10-13T14:38:00",
  "steps": [
    {
      "step": "window",
      "width": 1200,
      "height": 760
    },
    {
      "step": "prefs",
      "prefs": {
        "theme": "light",
        "accent": "#007aff",
        "zoomPercent": 100,
        "density": "comfortable",
        "viewMode": "details",
        "sortBy": "name",
        "sortDirection": "asc",
        "favoritesPlacement": "separate"
      }
    },
    {
      "step": "open",
      "path": "app/src/components"
    },
    {
      "step": "wait",
      "ms": 300
    },
    {
      "step": "click",
      "element": "list row",
      "text": "Avatar.jsx"
    },
    {
      "step": "contextMenu",
      "element": "list row",
      "text": "Avatar.jsx",
      "choose": "Show Info"
    },
    {
      "step": "expect",
      "element": "info panel",
      "visible": true
    },
    {
      "step": "wait",
      "ms": 400
    },
    {
      "step": "snapshot",
      "name": "main"
    },
    {
      "step": "geometry",
      "name": "main"
    }
  ]
}
