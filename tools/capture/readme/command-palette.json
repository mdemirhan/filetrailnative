{
  "name": "command-palette",
  "description": "The command palette finding the commands for panes",
  "root": "/Users/Shared/Lighthouse",
  "steps": [
    {
      "step": "window",
      "width": 1000,
      "height": 625
    },
    {
      "step": "prefs",
      "prefs": {
        "theme": "light",
        "accent": "#007aff",
        "density": "standard",
        "viewMode": "details",
        "sortBy": "name",
        "sortDirection": "asc",
        "favoritesPlacement": "separate",
        "notificationsEnabled": false
      }
    },
    {
      "step": "rootTree",
      "path": "/Users/Shared/Lighthouse"
    },
    {
      "step": "open",
      "path": "app/src/components"
    },
    {
      "step": "wait",
      "ms": 500
    },
    {
      "step": "key",
      "key": "p",
      "modifiers": [
        "cmd",
        "shift"
      ]
    },
    {
      "step": "expectSheet",
      "name": "command palette"
    },
    {
      "step": "type",
      "text": "pane"
    },
    {
      "step": "wait",
      "ms": 600
    },
    {
      "step": "snapshot",
      "name": "preview"
    },
    {
      "step": "windowShot",
      "name": "command-palette"
    }
  ]
}
