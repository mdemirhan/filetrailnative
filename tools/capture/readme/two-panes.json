{
  "name": "two-panes",
  "description": "Two panes: photos in a list, and as icons the folder three of them were just copied to with F5",
  "root": "/Users/Shared/Lighthouse",
  "steps": [
    {
      "step": "window",
      "width": 1000,
      "height": 625
    },
    {
      "step": "prefs",
      "prefs": {
        "theme": "light",
        "accent": "#007aff",
        "density": "standard",
        "viewMode": "icons",
        "sortBy": "name",
        "sortDirection": "asc",
        "favoritesPlacement": "separate",
        "notificationsEnabled": false
      }
    },
    {
      "step": "rootTree",
      "path": "/Users/Shared/Lighthouse"
    },
    {
      "step": "open",
      "path": "Portfolio"
    },
    {
      "step": "wait",
      "ms": 500
    },
    {
      "step": "command",
      "id": "toggleTwoPanes"
    },
    {
      "step": "wait",
      "ms": 500
    },
    {
      "step": "open",
      "path": "photos"
    },
    {
      "step": "wait",
      "ms": 300
    },
    {
      "step": "command",
      "id": "viewAsDetails"
    },
    {
      "step": "wait",
      "ms": 1200
    },
    {
      "step": "select",
      "names": [
        "Alpine lake.jpg",
        "Cape Point.jpg",
        "Coast road.jpg"
      ]
    },
    {
      "step": "menu",
      "path": [
        "Edit",
        "Copy to Other Pane"
      ]
    },
    {
      "step": "wait",
      "ms": 1500
    },
    {
      "step": "snapshot",
      "name": "preview"
    },
    {
      "step": "windowShot",
      "name": "two-panes"
    }
  ]
}
