{
  "name": "search-groups",
  "description": "Search results for trip, grouped by the folder each is in",
  "root": "/Users/Shared/Lighthouse",
  "steps": [
    {
      "step": "window",
      "width": 1000,
      "height": 625
    },
    {
      "step": "prefs",
      "prefs": {
        "theme": "light",
        "accent": "#007aff",
        "density": "standard",
        "viewMode": "details",
        "sortBy": "name",
        "sortDirection": "asc",
        "favoritesPlacement": "separate",
        "notificationsEnabled": false
      }
    },
    {
      "step": "rootTree",
      "path": "/Users/Shared/Lighthouse"
    },
    {
      "step": "open",
      "path": "."
    },
    {
      "step": "key",
      "key": "f",
      "modifiers": [
        "cmd"
      ]
    },
    {
      "step": "type",
      "text": "trip"
    },
    {
      "step": "wait",
      "ms": 2000
    },
    {
      "step": "command",
      "id": "groupByFolder"
    },
    {
      "step": "wait",
      "ms": 1000
    },
    {
      "step": "snapshot",
      "name": "preview"
    },
    {
      "step": "windowShot",
      "name": "search-groups"
    }
  ]
}
