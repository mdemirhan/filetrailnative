{
  "name": "filter",
  "description": "A fuzzy filter typed in a folder, its letters marked",
  "root": "/Users/Shared/Lighthouse",
  "steps": [
    {
      "step": "window",
      "width": 1000,
      "height": 625
    },
    {
      "step": "prefs",
      "prefs": {
        "theme": "light",
        "accent": "#007aff",
        "density": "standard",
        "viewMode": "details",
        "sortBy": "name",
        "sortDirection": "asc",
        "favoritesPlacement": "separate",
        "notificationsEnabled": false,
        "listFilterMatch": "fuzzy"
      }
    },
    {
      "step": "rootTree",
      "path": "/Users/Shared/Lighthouse"
    },
    {
      "step": "open",
      "path": "app/src/components"
    },
    {
      "step": "wait",
      "ms": 500
    },
    {
      "step": "type",
      "text": "trptl"
    },
    {
      "step": "wait",
      "ms": 800
    },
    {
      "step": "snapshot",
      "name": "preview"
    },
    {
      "step": "windowShot",
      "name": "filter"
    }
  ]
}
