{
  "cases": [
    {"name": "empty", "input": [], "output": []},
    {"name": "root alone", "input": ["/"], "output": ["/"]},
    {"name": "root takes everything", "input": ["/", "/a", "/a/b", "relative"], "output": ["/", "relative"]},
    {"name": "root picked last", "input": ["/a/b", "/x", "/"], "output": ["/"]},
    {"name": "child before parent", "input": ["/a/b", "/a"], "output": ["/a"]},
    {"name": "parent before child", "input": ["/a", "/a/b", "/c"], "output": ["/a", "/c"]},
    {"name": "deep descendant", "input": ["/a/b/c/d", "/a/b"], "output": ["/a/b"]},
    {"name": "exact duplicates", "input": ["/a", "/a", "/b", "/a"], "output": ["/a", "/b"]},
