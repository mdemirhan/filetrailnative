    {"name": "emoji", "input": ["/🎉", "/🎉/👩‍👩‍👧‍👦", "/🎈/🎉"], "output": ["/🎉", "/🎈/🎉"]},
    {"name": "spaces", "input": ["/a b", "/a b/c", "/a  b/c"], "output": ["/a b", "/a  b/c"]},
    {
      "name": "home and trash",
      "input": ["/Users/me", "/Users/me/.Trash/x", "/Users/meme"],
      "output": ["/Users/me", "/Users/meme"]
    },
    {
