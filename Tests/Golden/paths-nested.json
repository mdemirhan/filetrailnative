    {"name": "nfc parent, nfc child", "input": ["/Café", "/Café/x"], "output": ["/Café"]},
    {"name": "nfc and nfd duplicates", "input": ["/Zoë", "/Zoë", "/Zoë"], "output": ["/Zoë", "/Zoë"]},
    {"name": "combining mark after a slash", "input": ["/a", "/a/́"], "output": ["/a"]},
    {"name": "relative paths", "input": ["a", "a/b", "b/c", "b"], "output": ["a", "b"]},
    {"name": "empty string picked", "input": ["", "/a", "a"], "output": ["", "/a", "a"]},
    {"name": "dot components", "input": ["/a/.", "/a/./b", "/a/..", "/a/../c"], "output": ["/a/.", "/a/.."]},
    {
