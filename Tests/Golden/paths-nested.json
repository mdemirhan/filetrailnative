      "name": "sibling with shared prefix",
      "input": ["/ab", "/a", "/a b", "/a-b"],
      "output": ["/ab", "/a", "/a b", "/a-b"]
    },
    {"name": "trailing slash is not an ancestor", "input": ["/a/", "/a/b"], "output": ["/a/", "/a/b"]},
    {"name": "trailing slash and a double slash", "input": ["/a/", "/a//b"], "output": ["/a/"]},
    {"name": "double slash under root", "input": ["/", "//x"], "output": ["/"]},
    {"name": "double slash root kept apart", "input": ["//", "/a"], "output": ["//", "/a"]},
    {
