        "folder": "/u/a"
      },
      "output": {
        "view": "previews · folderView",
        "groupBy": "none · pane",
        "sort": "name asc · pane",
        "foldersFirst": "true · pane",
        "columns": "kind shown · pane",
        "size": "64 · pane"
      }
