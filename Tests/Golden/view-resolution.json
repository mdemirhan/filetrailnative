{
  "bases": {
    "1 no view": {
      "input": {"views": [], "folder": "/u/a"},
      "output": {
        "view": "icons · pane",
        "groupBy": "none · pane",
        "sort": "name asc · pane",
        "foldersFirst": "true · pane",
        "columns": "kind shown · pane",
        "size": "64 · pane"
      }
    },
    "2 own view keeping View": {
      "input": {"views": [{"path": "/u/a", "subfolders": false, "keeps": {"view": "details"}}], "folder": "/u/a"},
      "output": {
        "view": "details · folderView",
        "groupBy": "none · pane",
        "sort": "name asc · pane",
        "foldersFirst": "true · pane",
        "columns": "kind shown · pane",
        "size": "64 · pane"
      }
    },
    "3 own view keeping all six": {
      "input": {
        "views": [
          {
            "path": "/u/a",
            "subfolders": false,
            "keeps": {
              "view": "details",
              "groupBy": "kind",
              "sort": {"by": "modified", "direction": "desc"},
              "foldersFirst": false,
              "columns": {"visibility": {"kind": false}},
              "size": {"iconSizes": {"standard": 96}}
            }
          }
        ],
        "folder": "/u/a"
      },
      "output": {
        "view": "details · folderView",
        "groupBy": "kind · folderView",
        "sort": "modified desc · folderView",
        "foldersFirst": "false · folderView",
        "columns": "kind hidden · folderView",
        "size": "96 · folderView"
      }
    },
    "4 view from the parent": {
      "input": {
        "views": [
          {
            "path": "/u",
            "subfolders": true,
            "keeps": {"view": "details", "sort": {"by": "modified", "direction": "desc"}}
          }
        ],
        "folder": "/u/a"
      },
      "output": {
        "view": "details · folderView",
        "groupBy": "none · pane",
        "sort": "modified desc · folderView",
        "foldersFirst": "true · pane",
        "columns": "kind shown · pane",
        "size": "64 · pane"
      }
    },
    "5 own view over the parent's": {
      "input": {
        "views": [
          {
            "path": "/u",
            "subfolders": true,
