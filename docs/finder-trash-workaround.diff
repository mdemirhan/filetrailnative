diff --git a/Sources/FTFileSystem/System/FinderTrashDisks.swift b/Sources/FTFileSystem/System/FinderTrashDisks.swift
new file mode 100644
index 0000000..76f4f1e
--- /dev/null
+++ b/Sources/FTFileSystem/System/FinderTrashDisks.swift
@@ -0,0 +1,113 @@
+import Darwin
+import Foundation
+
+/// Finder's Trash leaves out a disk whose Trash it hasn't taken on. It takes it on when it moves something to the Trash
+/// there, or when the disk is mounted with a Trash already on it; from then on it shows all of that Trash and empties
+/// it. What `FileManager.trashItem` moves doesn't count, and neither do `NSWorkspace.recycle`, `noteFileSystemChanged`
+/// or Finder's `update`.
+///
+/// So Finder is given a throwaway file to trash on such a disk, and the file is then removed. People's own items never
+/// go through Finder: its `delete` follows a symlink and trashes what the link points at. Finder marks the disk's Trash
+/// folder hidden when it takes it on, which is how a disk it knows is told. That is read each time rather than kept: it
+/// costs next to nothing beside the move itself, and what was kept would go stale when another disk takes the name.
+///
+/// None of this holds up a move. Finder shows what was trashed before it took the disk on as well, so it is asked after
+/// the move and on a queue of its own, where a slow Finder or its permission prompt keeps no one waiting.
+public final class FinderTrashDisks: @unchecked Sendable {
+    public static let live = FinderTrashDisks()
+
+    private let uid: UInt32
+    private let run: @Sendable (String) throws -> Void
+    private let diskHolding: @Sendable (String) -> String?
+    private let queue = DispatchQueue(label: "FinderTrashDisks", qos: .utility)
+    private let lock = NSLock()
+    /// Disks Finder is about to be asked about, so that a batch asks once.
+    private var waiting: Set<String> = []
+    /// Disks Finder wouldn't do this for (no permission, not running). It isn't asked again until the next launch.
+    private var refused: Set<String> = []
+
+    public init(
+        uid: UInt32 = getuid(), run: @escaping @Sendable (String) throws -> Void = TrashState.runAppleScriptNow,
+        diskHolding: @escaping @Sendable (String) -> String? = FinderTrashDisks.localDisk(holding:)
+    ) {
+        self.uid = uid
+        self.run = run
+        self.diskHolding = diskHolding
+    }
+
+    /// After `path` was moved to the Trash. Its folder takes the throwaway file, as it was just written to. Returns at
+    /// once; a failure leaves the item in the Trash, only not yet shown by Finder.
+    public func didTrash(_ path: String) {
+        let folder = (path as NSString).deletingLastPathComponent
+        guard let disk = diskHolding(folder), !Self.isHidden(trash(on: disk)) else { return }
+        let isNew = lock.withLock { !refused.contains(disk) && waiting.insert(disk).inserted }
+        guard isNew else { return }
+        queue.async { [self] in
+            introduce(disk, in: folder)
+            lock.withLock { _ = waiting.remove(disk) }
+        }
+    }
+
+    /// Before Finder empties the Trash, so that it also empties the Trash of a disk it doesn't know yet. Waits for
+    /// Finder, and for what it was already asked: call it off the main thread. A Trash Finder knows isn't read, as a
+    /// large one takes a while.
+    public func prepareToEmpty(_ trashes: [String], read: TrashState.Reader = TrashState.readDirectory) {
+        queue.sync {
+            for trash in trashes where !Self.isHidden(trash) {
+                guard let names = try? read(trash), names.contains(where: { $0 != ".DS_Store" }) else { continue }
+                let disk = TrashFolders.disk(of: trash)
+                introduce(disk, in: disk)
+            }
+        }
+    }
+
+    /// Waits for what Finder was asked.
+    func finish() {
+        queue.sync {}
+    }
+
+    private func trash(on disk: String) -> String {
+        "\(disk)/.Trashes/\(uid)"
+    }
+
+    private func introduce(_ disk: String, in folder: String) {
+        let trash = trash(on: disk)
+        guard !lock.withLock({ refused.contains(disk) }), !Self.isHidden(trash) else { return }
+        let name = ".File Trail \(UUID().uuidString)"
+        let file = "\(folder)/\(name)"
+        guard FileManager.default.createFile(atPath: file, contents: nil) else { return }
+        do {
+            try run(Self.deleteScript(file))
+            unlink("\(trash)/\(name)")
+        } catch {
+            lock.withLock { _ = refused.insert(disk) }
+            unlink(file)
+        }
+    }
+
+    static func deleteScript(_ path: String) -> String {
+        let quoted = path.replacingOccurrences(of: "\\", with: "\\\\").replacingOccurrences(of: "\"", with: "\\\"")
+        return """
+            with timeout of 60 seconds
+            tell application "Finder" to delete (POSIX file "\(quoted)" as alias)
+            end timeout
+            """
+    }
+
+    private static func isHidden(_ path: String) -> Bool {
+        var info = Darwin.stat()
+        return lstat(path, &info) == 0 && info.st_flags & UInt32(UF_HIDDEN) != 0
+    }
+
+    /// The disk under /Volumes that holds `path`, when it is a local one: the startup disk's Trash is the home folder's,
+    /// and a network share has none. The system says where the path is, so a link to the startup disk doesn't count.
+    public static func localDisk(holding path: String) -> String? {
+        var info = Darwin.statfs()
+        guard statfs(path, &info) == 0, info.f_flags & UInt32(MNT_LOCAL) != 0 else { return nil }
+        let mount = withUnsafePointer(to: &info.f_mntonname) {
+            $0.withMemoryRebound(to: CChar.self, capacity: Int(MAXPATHLEN)) { String(cString: $0) }
+        }
+        let parts = mount.split(separator: "/")
+        return parts.count == 2 && parts[0] == "Volumes" ? mount : nil
+    }
+}
