diff --git a/Tests/FTFileSystemTests/System/FinderTrashDisksTests.swift b/Tests/FTFileSystemTests/System/FinderTrashDisksTests.swift
new file mode 100644
index 0000000..8d3010f
--- /dev/null
+++ b/Tests/FTFileSystemTests/System/FinderTrashDisksTests.swift
@@ -0,0 +1,186 @@
+import Darwin
+import FTTestSupport
+import Foundation
+import Testing
+
+@testable import FTFileSystem
+
+@Suite struct FinderTrashDisksTests {
+    private final class Finder: @unchecked Sendable {
+        private let lock = NSLock()
+        private var scripts: [String] = []
+        var asked: [String] { lock.withLock { scripts } }
+
+        func add(_ script: String) { lock.withLock { scripts.append(script) } }
+    }
+
+    private struct Refused: Error {}
+
+    private func trashFolder(on disk: String) throws -> String {
+        let trash = disk + "/.Trashes/501"
+        try FileManager.default.createDirectory(atPath: trash, withIntermediateDirectories: true)
+        return trash
+    }
+
+    /// A Finder that moves the file named in the script to the disk's Trash, as Finder's `delete` does.
+    private func disks(on disk: String?, finder: Finder) -> FinderTrashDisks {
+        FinderTrashDisks(
+            uid: 501,
+            run: { script in
+                finder.add(script)
+                let path = try #require(script.split(separator: "\"").first { $0.hasPrefix("/") }).description
+                let name = (path as NSString).lastPathComponent
+                try FileManager.default.moveItem(atPath: path, toPath: "\(disk ?? "")/.Trashes/501/\(name)")
+            },
+            diskHolding: { _ in disk })
+    }
+
+    private func names(_ folder: String) throws -> [String] {
+        try FileManager.default.contentsOfDirectory(atPath: folder)
+    }
+
+    @Test func finderTrashesAThrowawayFileThatIsThenGoneAndNeverTheItem() throws {
+        try withTemporaryDirectory { directory in
+            let disk = directory.path
+            let trash = try trashFolder(on: disk)
+            FileManager.default.createFile(atPath: trash + "/photo.jpg", contents: nil)
+            let finder = Finder()
+            let subject = disks(on: disk, finder: finder)
+
+            subject.didTrash(disk + "/photo.jpg")
+            subject.finish()
+
+            #expect(finder.asked.count == 1)
+            #expect(!finder.asked[0].contains("photo.jpg"))
+            #expect(try names(trash) == ["photo.jpg"])
+            #expect(try names(disk) == [".Trashes"])
+        }
+    }
+
+    @Test func aMoveDoesNotWaitForFinderAndABatchAsksOnce() throws {
+        try withTemporaryDirectory { directory in
+            let disk = directory.path
+            _ = try trashFolder(on: disk)
+            let finder = Finder()
+            let answer = DispatchSemaphore(value: 0)
+            let slow = FinderTrashDisks(
+                uid: 501,
+                run: { script in
+                    finder.add(script)
+                    answer.wait()
+                },
+                diskHolding: { _ in disk })
+
+            // Finder hasn't answered, and these return all the same.
+            for index in 0..<100 { slow.didTrash(disk + "/\(index).txt") }
+            answer.signal()
+            slow.finish()
+
+            #expect(finder.asked.count == 1)
+        }
+    }
+
+    @Test func finderIsNotAskedForADiskItAlreadyKnows() throws {
+        try withTemporaryDirectory { directory in
+            let disk = directory.path
+            let trash = try trashFolder(on: disk)
+            #expect(chflags(trash, UInt32(UF_HIDDEN)) == 0)
+            let finder = Finder()
+
+            let subject = disks(on: disk, finder: finder)
+            subject.didTrash(disk + "/a.txt")
+            subject.finish()
+
+            #expect(finder.asked.isEmpty)
+        }
+    }
+
+    @Test func finderIsNotAskedForAPathOffOtherDisks() {
+        let finder = Finder()
+        let subject = disks(on: nil, finder: finder)
+        subject.didTrash("/Users/me/a.txt")
+        subject.finish()
+        #expect(finder.asked.isEmpty)
+    }
+
+    @Test func aFinderThatRefusesIsAskedOnceAndLeavesNoFileBehind() throws {
+        try withTemporaryDirectory { directory in
+            let disk = directory.path
+            _ = try trashFolder(on: disk)
+            let finder = Finder()
+            let refusing = FinderTrashDisks(
+                uid: 501,
+                run: { script in
+                    finder.add(script)
+                    throw Refused()
+                },
+                diskHolding: { _ in disk })
+
+            refusing.didTrash(disk + "/a.txt")
+            refusing.finish()
+            refusing.didTrash(disk + "/b.txt")
+            refusing.finish()
+
+            #expect(finder.asked.count == 1)
+            #expect(try names(disk) == [".Trashes"])
+        }
+    }
+
+    @Test func aFolderThatCantBeWrittenToAsksNothing() {
+        let finder = Finder()
+        let subject = disks(on: "/Volumes/Gone", finder: finder)
+        subject.didTrash("/Volumes/Gone/missing/a.txt")
+        subject.finish()
+        #expect(finder.asked.isEmpty)
+    }
+
+    @Test func emptyingAsksOnlyForDisksWhoseTrashHoldsItems() throws {
+        try withTemporaryDirectory { directory in
+            let disk = directory.path + "/Full"
+            let trash = try trashFolder(on: disk)
+            let onlyDSStore = try trashFolder(on: directory.path + "/Bare")
+            let missing = directory.path + "/None/.Trashes/501"
+            let finder = Finder()
+
+            disks(on: disk, finder: finder).prepareToEmpty(
+                [trash, onlyDSStore, missing],
+                read: { path in
+                    if path == trash { return ["a.txt"] }
+                    if path == onlyDSStore { return [".DS_Store"] }
+                    throw POSIXError(.ENOENT)
+                })
+
+            #expect(finder.asked.count == 1)
+            #expect(finder.asked[0].contains(disk + "/.File Trail "))
+            #expect(try names(disk) == [".Trashes"])
+        }
+    }
+
+    @Test func emptyingDoesNotReadATrashFinderKnows() throws {
+        try withTemporaryDirectory { directory in
+            let disk = directory.path
+            let trash = try trashFolder(on: disk)
+            #expect(chflags(trash, UInt32(UF_HIDDEN)) == 0)
+            let finder = Finder()
+
+            disks(on: disk, finder: finder).prepareToEmpty(
+                [trash],
+                read: { path in
+                    Issue.record("read \(path)")
+                    return []
+                })
+
+            #expect(finder.asked.isEmpty)
+        }
+    }
+
+    @Test func aPathIsQuotedForTheScript() {
+        let script = FinderTrashDisks.deleteScript(#"/Volumes/A "B"\C/.x"#)
+        #expect(script.contains(#"POSIX file "/Volumes/A \"B\"\\C/.x" as alias"#))
+    }
+
+    @Test func theStartupDiskIsNotAnotherDisk() {
+        #expect(FinderTrashDisks.localDisk(holding: NSHomeDirectory()) == nil)
+        #expect(FinderTrashDisks.localDisk(holding: "/Volumes/No Such Disk/a") == nil)
+    }
+}
