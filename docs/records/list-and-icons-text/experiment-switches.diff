diff --git a/Sources/FTAppKit/Content/List/ListLabels.swift b/Sources/FTAppKit/Content/List/ListLabels.swift
index dd14763a..caf13d75 100644
--- a/Sources/FTAppKit/Content/List/ListLabels.swift
+++ b/Sources/FTAppKit/Content/List/ListLabels.swift
@@ -5,7 +5,40 @@ import FTFoundation
 
 /// A line of text in a cell. The text starts at the left edge of its frame, and the pointer
 /// goes through it to the row.
+/// EXPERIMENT, measuring only: switches for the List's row costs.
+enum ListExperiment {
+    static let whole = ProcessInfo.processInfo.environment["FT_EXP_LIST_WHOLE"] == "1"
+    static let noTips = ProcessInfo.processInfo.environment["FT_EXP_LIST_NOTIPS"] == "1"
+    static let fewer = ProcessInfo.processInfo.environment["FT_EXP_LIST_FEWER"] == "1"
+    static let barLayer = ProcessInfo.processInfo.environment["FT_EXP_LIST_BARLAYER"] == "1"
+}
+
 class ListLabel: NSTextField {
+    /// EXPERIMENT: drawn whole into a plain layer of its own.
+    private var drawsWhole = false
+
+    func drawWholeForExperiment(force: Bool = false) {
+        guard ListExperiment.whole || force else { return }
+        drawsWhole = true
+        wantsLayer = true
+        layerContentsRedrawPolicy = .onSetNeedsDisplay
+    }
+
+    override func makeBackingLayer() -> CALayer {
+        guard drawsWhole else { return super.makeBackingLayer() }
+        let layer = CALayer()
+        layer.needsDisplayOnBoundsChange = true
+        layer.contentsScale = window?.backingScaleFactor ?? NSScreen.main?.backingScaleFactor ?? 2
+        return layer
+    }
+
+    override func viewDidChangeBackingProperties() {
+        super.viewDidChangeBackingProperties()
+        guard drawsWhole, let layer, let scale = window?.backingScaleFactor, layer.contentsScale != scale else { return }
+        layer.contentsScale = scale
+        needsDisplay = true
+    }
+
     override class var cellClass: AnyClass? {
         get { ThemedTextCell.self }
         set {}
