@@ -93,6 +93,43 @@ class IconViewController: ItemGridPane {
         // Another folder, or the same from its top: the way the last one was scrolled says nothing of this one.
         lastTopAhead = Double(scroll.contentView.bounds.origin.y)
         aheadGoesUp = false
+        startWarmingNames()
+    }
+
+    // MARK: EXPERIMENT: names fitted while idle
+
+    private static let warmsNames = ProcessInfo.processInfo.environment["FT_EXP_ICONS_WARM"] == "1"
+    private var warmNext = 0
+    private var warmWork: DispatchWorkItem?
+
+    private func startWarmingNames() {
+        guard Self.warmsNames else { return }
+        warmWork?.cancel()
+        warmNext = 0
+        scheduleWarm(after: 0.3)
+    }
+
+    private func scheduleWarm(after delay: Double) {
+        let work = DispatchWorkItem { [weak self] in
+            MainActor.assumeIsolated { self?.warmSlice() }
+        }
+        warmWork = work
+        DispatchQueue.main.asyncAfter(deadline: .now() + delay, execute: work)
+    }
+
+    /// Fits names for at most 4 ms, then gives the main thread back for a turn.
+    private func warmSlice() {
+        let began = ContinuousClock.now
+        let layout = self.layout
+        while warmNext < entries.count {
+            let entry = entries[warmNext]
+            warmNext += 1
+            let fitted = IconLabelText.fit(name: entry.name, extension: entry.fileExtension, layout: layout)
+            _ = IconLabelText.lines(fitted, layout: layout)
+            _ = IconLabelText.width(fitted, layout: layout)
+            if ContinuousClock.now - began > .milliseconds(4) { break }
+        }
+        if warmNext < entries.count { scheduleWarm(after: 0.001) }
     }
 
     isolated deinit {
